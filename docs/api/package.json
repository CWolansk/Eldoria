{
  "name": "eldoria-character-api",
  "version": "0.1.0",
  "description": "Azure Functions API for Eldoria cloud-backed PlayerSheetDTO v2 sheets.",
  "private": true,
  "main": "src/index.js",
  "scripts": {
    "start": "func start",
    "check": "node tools/check-syntax.js",
    "test:resilience": "node tools/test-api-resilience.mjs",
    "migrate:player-portraits": "node tools/migrate-player-portraits.mjs",
    "test:item-search-index": "node tools/test-item-search-index.js && node tools/test-item-search-v2-index.js && node tools/test-item-search-client.mjs && node tools/test-homebrew-items.js",
    "prepare:item-catalog": "node tools/prepare-item-catalog.js",
    "seed": "node seed/seedBlobStorage.js",
    "seed:characters": "node seed/seedBlobStorage.js",
    "seed:reset-players": "node seed/seedBlobStorage.js --purge-character-documents",
    "seed:catalog": "node seed/seedTableStorage.js",
    "seed:catalog:item-search": "node seed/seedTableStorage.js --search-index-only",
    "deploy": "powershell -ExecutionPolicy Bypass -File apiDeploy/deploy.ps1",
    "buddy:actions": "node apiClient/tester-actions-server.cjs"
  },
  "dependencies": {
    "@azure/data-tables": "^13.3.2",
    "@azure/functions": "^4.6.0",
    "@azure/identity": "^4.13.0",
    "@azure/storage-blob": "^12.29.1"
  }
}
